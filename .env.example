# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-here

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:65110,http://127.0.0.1:65110

# Database (MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barangay_request_system
DB_USERNAME=root
DB_PASSWORD=
